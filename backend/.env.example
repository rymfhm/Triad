# Band Platform Credentials
# Create agents at https://app.band.ai/agents
INGEST_AGENT_ID=
INGEST_API_KEY=
ANALYST_AGENT_ID=
ANALYST_API_KEY=
MANAGER_AGENT_ID=
MANAGER_API_KEY=

# LLM Provider (pick one)
# Google Gemini (free tier)
GEMINI_API_KEY=

# OR Groq (free tier for open-source models)
GROQ_API_KEY=

# Band Platform URLs (optional - defaults to Band Cloud)
BAND_REST_URL=
BAND_WS_URL=

# Google Drive Backup (optional)
# Create service account at https://console.cloud.google.com
# Enable Drive API → download credentials JSON
GOOGLE_DRIVE_CREDENTIALS=
# Folder ID from the Drive folder shared with service account
GOOGLE_DRIVE_FOLDER_ID=

# API Key Auth (optional - leave empty to disable)
API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
